{
  "name": "open-reader",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "Lector de EPUB, MOBI y PDF en el navegador con notas, resaltados y marcadores. Sin cuentas, sin servidor.",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "app:build": "npm run build && tauri build --no-bundle",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.7.60",
    "fflate": "^0.8.2",
    "pdfjs-dist": "5.5.207",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.0.0",
    "sass": "^1.93.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.0"
  }
}
